function updateEnemyMesh(e,root){
  const u=root.userData,r=e.r*SC;
  root.position.set(wx(e.x),wy(e.zb||0),wz(e.y));
  const spawnDur=e.isBoss?1.4:.7;
  if(e.spawn>0){
    const p=clamp(1-e.spawn/spawnDur,.02,1);u.pivot.scale.setScalar(p);
    u.portal.visible=true;u.portal.scale.setScalar(r*2.4*(1.5-.5*p));
  }else{u.pivot.scale.setScalar(1);u.portal.visible=false;}
  root.visible=!(e.isBoss&&e.hide);
  u.pivot.rotation.y=-e.face;
  const f=e.flash>0;
  for(const m of u.mats){
    if(f){m.emissive.setRGB(1,1,1);m.emissiveIntensity=1.3;}
    else{
      if(e.vuln>0){m.emissive.setRGB(1,.85,.2);m.emissiveIntensity=.7;}
      else{m.emissive.copy(m.userData.base);m.emissiveIntensity=m.userData.ei;}
    }
    if(e.type==='wraith')m.opacity=Math.max(.05,e.alpha*.85);
  }
  u.stars.visible=(e.stun>0)||(e.isBoss&&e.vuln>0);u.stars.rotation.y=time*6;
  if(e.type==='imp'){u.tel.visible=e.st===1;}
  else if(e.type==='shade'){u.orb.scale.setScalar(r*(e.st===1?.45+e.t*1.4:.45));}
  else if(e.type==='wraith'){u.pivot.position.y=Math.sin(time*3+e.x)*.15+.1;}
  else if(e.type==='mite'){u.spin.rotation.y=time*6;u.core.scale.setScalar(r*(.3+.2*Math.sin(time*18)));}
  else if(e.isBoss){
    u.spikes.rotation.y=time*.5;u.ring1.rotation.set(time*.7,0,time*.3);u.ring2.rotation.set(0,time*.5,time*-.6);
    if(u.halo)u.halo.rotation.z=time*.8;
    u.shield.visible=e.invuln>0;
    if(!f&&e.vuln<=0){for(const m of u.mats){m.emissive.copy(m.userData.base);}}
  }
}

/* ---------- hazards ---------- */
function makeHazard(h){
  const g=new THREE.Group(),u={};
  if(h.k==='circle'){
    u.fill=new THREE.Mesh(G.disc,bmat(h.col,{opacity:.2}));u.fill.rotation.x=-Math.PI/2;u.fill.position.y=.07;
    u.edge=new THREE.Mesh(G.ring,bmat(h.col,{opacity:.95}));u.edge.rotation.x=-Math.PI/2;u.edge.position.y=.09;
    u.grow=new THREE.Mesh(G.disc,bmat(h.col,{opacity:.4}));u.grow.rotation.x=-Math.PI/2;u.grow.position.y=.08;
    u.col=new THREE.Mesh(G.wall,bmat('#ffffff',{opacity:0}));
    g.add(u.fill,u.edge,u.grow,u.col);
  }else if(h.k==='line'){
    u.fill=new THREE.Mesh(G.box,bmat(h.col,{opacity:.2}));u.edge=new THREE.Mesh(G.box,bmat(h.col,{opacity:.9}));u.hot=new THREE.Mesh(G.box,bmat('#ffffff',{opacity:0}));
    g.add(u.fill,u.edge,u.hot);
  }else if(h.k==='wave'){
    u.wall=new THREE.Mesh(G.wall,bmat(h.col,{opacity:.55}));u.flat=new THREE.Mesh(G.ring,bmat('#ffffff',{opacity:.7}));u.flat.rotation.x=-Math.PI/2;u.flat.position.y=.1;
    g.add(u.wall,u.flat);
  }else if(h.k==='beam'){
    u.out=new THREE.Mesh(G.box,bmat(h.col,{opacity:.4}));u.core=new THREE.Mesh(G.box,bmat('#ffffff',{opacity:1}));u.line=new THREE.Mesh(G.box,bmat(h.col,{opacity:.6}));
    g.add(u.out,u.core,u.line);
  }
  g.userData=u;return g;
}
function updHazard(h,g){
  const u=g.userData;
  if(h.k==='circle'){
    const R=h.r*SC,p=clamp(h.t/h.dur,0,1);g.position.set(wx(h.x),0,wz(h.y));
    u.fill.scale.setScalar(R);u.edge.scale.setScalar(R);u.grow.scale.setScalar(Math.max(.01,R*p));
    if(!h.fired){u.fill.material.opacity=.1+.2*p;u.grow.material.opacity=.3+.4*p;u.edge.material.opacity=.95;u.col.material.opacity=0;}
    else{const q=Math.max(0,1-(h.t-h.dur)/.22);u.fill.material.opacity=q*.6;u.grow.material.opacity=0;u.edge.material.opacity=q;
      u.col.material.opacity=q*.65;u.col.material.color.set(h.col);u.col.scale.set(R,2+10*(1-q),R);u.col.position.y=u.col.scale.y/2;}
  }else if(h.k==='line'){
    const L=h.len*SC,Wd=h.w*SC;g.position.set(wx(h.x),0,wz(h.y));g.rotation.y=-h.ang;
    for(const m of [u.fill,u.edge]){m.scale.set(L,.05,Wd);m.position.set(L/2,.08,0);}
    u.hot.scale.set(L,.05,Wd);u.hot.position.set(L/2,.1,0);
    if(!h.fired){const p=clamp(h.t/h.dur,0,1);u.fill.material.opacity=.1+.25*p;u.edge.visible=false;u.hot.material.opacity=0;u.edge.visible=true;u.edge.scale.set(L,.05,Wd*(.15+.1*Math.sin(h.t*30)));}
    else{const q=Math.max(0,1-(h.t-h.dur)/.25);u.fill.material.opacity=q*.2;u.edge.visible=false;u.hot.material.opacity=q;u.hot.scale.y=.2+q*3;u.hot.position.y=u.hot.scale.y/2;}
  }else if(h.k==='wave'){
    const R=h.rad*SC;g.position.set(wx(h.x),0,wz(h.y));
    u.wall.scale.set(R,1.1,R);u.wall.position.y=.55;u.flat.scale.setScalar(R);
    const f=clamp(1-h.rad/900,0,1);u.wall.material.opacity=.55*f+.1;u.flat.material.opacity=.7*f;
  }else if(h.k==='beam'){
    g.position.set(wx(h.x),1.0,wz(h.y));g.rotation.y=-h.ang;
    const L=1800*SC,Wd=h.w*SC;
    if(h.t<h.tele){const p=h.t/h.tele;u.out.visible=false;u.core.visible=false;u.line.visible=true;u.line.scale.set(L,.05,.12+.1*p);u.line.position.x=L/2;u.line.material.opacity=.3+.6*p;}
    else{u.line.visible=false;u.out.visible=true;u.core.visible=true;u.out.scale.set(L,Wd*1.2,Wd*1.6);u.out.position.x=L/2;u.core.scale.set(L,Wd*.45,Wd*.56);u.core.position.x=L/2;
      const fl=.85+.15*Math.sin(h.t*60);u.out.material.opacity=.35*fl;}
  }
}


