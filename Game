}
function* slamAtk(b,rings){
  rings=rings||1;const R=b.r*3,tel=.85*(1-.1*b.phase);
  addCircle({x:b.x,y:b.y,r:R,dur:tel,dmg:22*b.ds,col:b.col});
  yield* wait(tel);
  for(let i=0;i<rings;i++){
    addWave({x:b.x,y:b.y,sp:340,dmg:16*b.ds,thick:26,col:b.col});
    if(i<rings-1)yield* wait(.55);
  }
  yield* wait(.5);
}
function* fanAtk(b,waves,n,spread){
  for(let w=0;w<waves;w++){
    const a=aimAng(b);
