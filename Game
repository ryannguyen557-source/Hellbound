function updatePlayer(dt){
  P.ang=P.yaw;
  P.inv=Math.max(0,P.inv-dt);P.hurt=Math.max(0,P.hurt-dt);P.landT=Math.max(0,P.landT-dt);P.dashFx=Math.max(0,P.dashFx-dt);
  if(P.dead){P.kx*=Math.exp(-5*dt);P.ky*=Math.exp(-5*dt);P.x+=P.kx*dt;P.y+=P.ky*dt;clampArena(P,P.r);P.eyeh=lerp(P.eyeh,10,Math.min(1,dt*6));return;}
  // arrow keys look fallback
  const lk=(keys.ArrowRight?1:0)-(keys.ArrowLeft?1:0),lu=(keys.ArrowUp?1:0)-(keys.ArrowDown?1:0);
  if(lk)P.yaw+=lk*2.4*dt;if(lu)P.pitch=clamp(P.pitch+lu*1.8*dt,-1.45,1.45);
  const ix=(keys.KeyD?1:0)-(keys.KeyA?1:0),iy=(keys.KeyW?1:0)-(keys.KeyS?1:0);
  const fx=Math.cos(P.yaw),fy=Math.sin(P.yaw),rx=-fy,ry=fx;
  let mx=fx*iy+rx*ix,my=fy*iy+ry*ix;const ml=Math.hypot(mx,my);if(ml>0){mx/=ml;my/=ml;}
  P.strafe=lerp(P.strafe,ix,Math.min(1,dt*10));
  const crouch=!!(keys.ControlLeft||keys.ControlRight||keys.KeyC);
  // dash
  P.dash=Math.min(3,P.dash+dt/1.1);
  if(press.Shift&&P.dash>=1&&P.dashT<=0){
    P.dash-=1;P.dashT=.17;P.dashA=ml>0?Math.atan2(my,mx):P.yaw;P.dashFx=.25;P.sliding=false;sfx.dash();
    burst(P.x,P.y,10,'#ff5a70',240,.3,2.5,true,20);
  }
  // jump
  if((press.Space||keys.Space)&&P.ground&&!P.slam){P.vz=JUMPV;P.ground=false;sfx.jump();P.sliding=false;}
  // slide / slam
  if(crouch){
    if(P.ground&&!P.sliding&&ml>0&&P.dashT<=0){P.sliding=true;P.slideA=Math.atan2(my,mx);P.slideV=Math.max(420,Math.hypot(P.vx,P.vy)*1.2);}
