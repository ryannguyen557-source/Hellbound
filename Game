            e.x=clamp(P.x+Math.cos(ba)*nd,A.x0+20,A.x1-20);e.y=clamp(P.y+Math.sin(ba)*nd,A.y0+20,A.y1-20);pushOut(e,e.r);
            e.st=2;e.t=0;addCircle({x:e.x,y:e.y,r:74,dur:.38,dmg:12,col:'#7be0d0'});
          }
        }else if(e.st===2){
          e.alpha=Math.min(1,e.alpha+dt*5);
          if(e.t>.5){e.st=0;e.cd=rnd(2,3);e.alpha=1;}
        }
        break;
      case 'mite':
        mx=dx/d*spd;my=dy/d*spd;
        if(d<e.r+P.r+16){e.dead=true;explode(e.x,e.y,75,18,35,'enemy');}
        break;
    }
  }
  moveEnt(e,mx,my,dt);
