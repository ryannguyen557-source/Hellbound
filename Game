      o.vx=lerp(o.vx,(P.x-o.x)/dl*s,k);o.vy=lerp(o.vy,(P.y-o.y)/dl*s,k);o.vz=lerp(o.vz,(pz-o.z)/dl*s,k);
    }else{o.vz-=GRAV*dt;o.vx*=Math.exp(-2*dt);o.vy*=Math.exp(-2*dt);}
    o.x+=o.vx*dt;o.y+=o.vy*dt;o.z+=o.vz*dt;
    if(o.z<4){o.z=4;o.vz=Math.abs(o.vz)*.5;}
