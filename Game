}
function beginWave(n){
  LV.wave=n;LV.phase='wave';
  const spec=LEVELS[lvlIdx].waves[n],q=[];
  for(const k in spec)for(let i=0;i<spec[k];i++)q.push(k);
  q.sort(()=>Math.random()-.5);LV.queue=q;LV.spT=.2;
  banner('Wave '+(n+1)+' / '+LEVELS[lvlIdx].waves.length,'',1.2,LEVELS[lvlIdx].glow);
}
function spawnPos(){
  for(let i=0;i<40;i++){
    const x=rnd(A.x0+50,A.x1-50),y=rnd(A.y0+50,A.y1-50);
    if(Math.hypot(x-P.x,y-P.y)<320)continue;
    if(obst.some(o=>Math.hypot(x-o.x,y-o.y)<o.r+40))continue;
    return {x,y};
  }
  return {x:rnd(A.x0+60,A.x1-60),y:A.y0+60};
}
function updateWave(dt){
  const lv=LEVELS[lvlIdx];
  if(mode==='dead')return;
  switch(LV.phase){
    case 'intro':LV.t+=dt;if(LV.t>2.2)beginWave(0);break;
    case 'wave':
      LV.time+=dt;LV.spT-=dt;
      if(LV.queue.length&&LV.spT<=0&&enemies.length<14){const t=LV.queue.shift(),p=spawnPos();spawnEnemy(t,p.x,p.y);LV.spT=.32;}
      if(!LV.queue.length&&enemies.length===0){
        P.hp=Math.min(P.max,P.hp+10);P.dash=3;
        if(LV.wave+1>=lv.waves.length){LV.phase='bossIntro';LV.t=0;banner(BOSSES[lv.boss].name,BOSSES[lv.boss].title,3,BOSSES[lv.boss].col);sfx.roar();}
        else{LV.phase='gap';LV.t=0;banner('Cleared','',1,lv.glow);}
      }
      break;
    case 'gap':LV.time+=dt;LV.t+=dt;if(LV.t>1.4)beginWave(LV.wave+1);break;
    case 'bossIntro':LV.time+=dt;LV.t+=dt;if(LV.t>3){spawnBoss(lv.boss);LV.phase='boss';}break;
    case 'boss':LV.time+=dt;break;
  }
}
function grade(){
  const par=LEVELS[lvlIdx].par;
  let g=100-LV.hits*7-Math.max(0,(LV.time-par)/par)*40+LV.peak*4;
  if(LV.time<par*.7)g+=5;
  return g>=96?'S':g>=82?'A':g>=66?'B':g>=50?'C':'D';
}
function finishLevel(){
  mode='clear';tscale=1;try{document.exitPointerLock();}catch(e){}
