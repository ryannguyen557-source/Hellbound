  clampArena(P,P.r);pushOut(P,P.r);
  P.step+=Math.hypot(vx,vy)*dt*(P.ground?1:.15)*.045;
  P.eyeh=lerp(P.eyeh,P.sliding?EYE*.5:EYE,Math.min(1,dt*14));
}

/* ---------- hazards ---------- */
function addCircle(o){hazards.push({k:'circle',x:o.x,y:o.y,r:o.r,t:0,dur:o.dur,dmg:o.dmg,col:o.col||'#ff3050',fired:false});}
function addLine(o){hazards.push({k:'line',x:o.x,y:o.y,ang:o.ang,len:o.len,w:o.w,t:0,dur:o.dur,dmg:o.dmg||0,col:o.col||'#ff3050',fired:false});}
function addWave(o){hazards.push({k:'wave',x:o.x,y:o.y,rad:20,sp:o.sp||340,thick:o.thick||26,dmg:o.dmg,col:o.col||'#ff7a50',hit:false});}
function addBeam(o){hazards.push({k:'beam',src:o.src,x:o.x||0,y:o.y||0,ang:o.ang,av:o.av||0,tele:o.tele||.9,dur:o.dur||3,t:0,w:o.w||30,dmg:o.dmg||16,col:o.col||'#ff3050'});}
function segDist(px,py,x,y,ang){
  const dx=px-x,dy=py-y,c=Math.cos(ang),s=Math.sin(ang);
  return {along:dx*c+dy*s,perp:Math.abs(-dx*s+dy*c)};
}
function updateHazards(dt){
  for(const h of hazards){
    h.t+=dt;
    if(h.k==='circle'){
      if(!h.fired&&h.t>=h.dur){
        h.fired=true;burst(h.x,h.y,18,h.col,320,.5,3.4,true,8);shake+=4;sfx.boom();
        if(h.dmg>0&&Math.hypot(P.x-h.x,P.y-h.y)<h.r+P.r*.5&&P.z<22)hurtPlayer(h.dmg,Math.atan2(P.y-h.y,P.x-h.x));
      }
    }else if(h.k==='line'){
      if(!h.fired&&h.t>=h.dur){
        h.fired=true;
        if(h.dmg>0){const s=segDist(P.x,P.y,h.x,h.y,h.ang);if(s.along>-10&&s.along<h.len&&s.perp<h.w/2+P.r*.5&&P.z<26)hurtPlayer(h.dmg);shake+=3;}
      }
    }else if(h.k==='wave'){
      h.rad+=h.sp*dt;
      if(!h.hit){const d=Math.hypot(P.x-h.x,P.y-h.y);if(Math.abs(d-h.rad)<h.thick/2+P.r*.5&&P.z<20&&P.inv<=0){h.hit=true;hurtPlayer(h.dmg,Math.atan2(P.y-h.y,P.x-h.x));}}
    }else if(h.k==='beam'){
      if(h.src){h.x=h.src.x;h.y=h.src.y;}
      if(h.t>=h.tele){
        h.ang+=h.av*dt;
        const s=segDist(P.x,P.y,h.x,h.y,h.ang);
        if(s.along>0&&s.perp<h.w/2+P.r*.5&&P.z<30)hurtPlayer(h.dmg);
      }
    }
  }
  hazards=hazards.filter(h=>{
    if(h.k==='circle')return h.t<h.dur+.22;
    if(h.k==='line')return h.t<h.dur+.25;
    if(h.k==='wave')return h.rad<1500;
    if(h.k==='beam')return h.t<h.tele+h.dur&&!(h.src&&h.src.dead);
    return false;
  });
}

/* ---------- orbs + fx ---------- */
function updateOrbs(dt){
  for(const o of orbs){
    o.t+=dt;
    const pz=P.z+EYE*.55,d=Math.hypot(P.x-o.x,P.y-o.y,pz-o.z);
