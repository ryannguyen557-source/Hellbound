<style>
/* Layout: one 16:9 stage holding a WebGL canvas, a transparent HUD canvas and DOM menu overlays, with a controls strip beneath it. Single dark look by choice. */
:root{
  --ink:#0b0609; --ink2:#160a10; --blood:#e0102b; --bone:#efe6d8; --ember:#ff8a1f; --surge:#5fd0ff; --dim:#9a868d; --line:#3a1a22;
  --display:'Pirata One','UnifrakturCook',Georgia,serif;
  --ui:'Barlow Condensed','Arial Narrow',Arial,sans-serif;
  color-scheme:dark;
}
html,body{background:var(--ink)}
body{
  background:var(--ink);color:var(--bone);font-family:var(--ui);
  padding-block:14px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
.wrap{display:flex;flex-direction:column;align-items:center;gap:12px}
.stage{
  position:relative;container-type:inline-size;
  width:min(100%,calc((100vh - 120px) * 16 / 9));
  width:min(100%,calc((100dvh - 120px) * 16 / 9));
  aspect-ratio:16/9;background:#000;border:1px solid var(--line);
}
canvas{position:absolute;inset:0;display:block;width:100%;height:100%;outline:none;cursor:none}
#gl{background:#0b0609;image-rendering:pixelated}
.ov{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:auto;
  background:radial-gradient(ellipse at 50% 40%,rgba(30,8,14,.78),rgba(6,2,4,.94) 75%);
  padding:2cqw;
}
.ov-in{max-width:64cqw;display:flex;flex-direction:column;align-items:center;gap:1.4cqw;text-align:center;margin:auto}
.eyebrow{margin:0;font-size:clamp(10px,1.5cqw,17px);letter-spacing:.22em;text-transform:uppercase;color:var(--dim);font-weight:600}
h1,h2{margin:0;font-family:var(--display);font-weight:400;color:var(--bone);text-wrap:balance;line-height:.95}
h1{font-size:min(13cqw,150px);color:var(--blood);text-shadow:0 0 .3em rgba(224,16,43,.45)}
h2{font-size:min(8cqw,90px)}
.lede{margin:0;max-width:46ch;font-size:clamp(12px,1.9cqw,21px);line-height:1.3;color:#cdbfc3;font-weight:500}
.levels{display:flex;flex-wrap:wrap;justify-content:center;gap:.8cqw}
.chip{
  font:600 clamp(11px,1.6cqw,18px)/1 var(--ui);letter-spacing:.08em;text-transform:uppercase;color:var(--bone);
  background:var(--ink2);border:1px solid var(--line);padding:.8cqw 1.3cqw;cursor:pointer;
}
.chip[aria-pressed="true"]{border-color:var(--blood);background:#2a0b13}
.chip:disabled{opacity:.35;cursor:not-allowed}
.chip b{font-family:var(--display);font-weight:400;font-size:1.4em;margin-right:.35em;color:var(--blood)}
.chk{display:flex;align-items:center;gap:.6em;font-size:clamp(11px,1.6cqw,18px);color:var(--dim);font-weight:500;cursor:pointer}
.chk input{accent-color:var(--blood);width:1.1em;height:1.1em}
.btns{display:flex;flex-wrap:wrap;justify-content:center;gap:1cqw}
.btn{
  font:700 clamp(13px,2.1cqw,24px)/1 var(--ui);letter-spacing:.14em;text-transform:uppercase;
  color:var(--bone);background:transparent;border:1px solid var(--bone);padding:1.1cqw 2.6cqw;cursor:pointer;
}
.btn:hover,.btn:focus-visible{background:var(--bone);color:var(--ink);outline:none}
.btn.primary{background:var(--blood);border-color:var(--blood);color:#fff}
.btn.primary:hover,.btn.primary:focus-visible{background:#ff2d48;border-color:#ff2d48;color:#fff}
.chip:focus-visible,.chk input:focus-visible{outline:2px solid var(--surge);outline-offset:2px}
.grade{font-family:var(--display);font-size:min(18cqw,200px);line-height:.8;color:var(--ember)}
.stats{display:grid;grid-template-columns:repeat(4,auto);gap:.4cqw 2.6cqw;margin:0}
.stats div{display:flex;flex-direction:column;align-items:center}
.stats dt{font-size:clamp(9px,1.3cqw,15px);letter-spacing:.2em;text-transform:uppercase;color:var(--dim);font-weight:600}
.stats dd{margin:0;font-size:clamp(14px,2.6cqw,30px);font-weight:700;font-variant-numeric:tabular-nums}
.note{margin:0;font-size:clamp(11px,1.7cqw,19px);color:var(--ember);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.keys{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;max-width:1100px;margin:0;padding:0;list-style:none;font-size:15px;color:var(--dim);font-weight:500}
.keys kbd{font:700 13px var(--ui);letter-spacing:.06em;color:var(--bone);background:var(--ink2);border:1px solid var(--line);padding:2px 7px;margin-right:5px}
.touch{display:none;margin:0;color:var(--ember);font-weight:600;font-size:16px;text-align:center}
@media (pointer:coarse){.touch{display:block}}
@media (max-width:560px){.stats{grid-template-columns:repeat(2,auto)}}
</style>

<main class="wrap">
  <p class="touch">Hellbound needs a keyboard and mouse. Open it on a computer to play.</p>
  <div class="stage" id="stage">
    <canvas id="gl" aria-hidden="true"></canvas>
    <canvas id="c" width="1280" height="720" tabindex="0" aria-label="Hellbound game canvas"></canvas>

    <div class="ov" id="ov-title">
      <div class="ov-in">
        <p class="eyebrow">First person · five circles · five wardens · blood is fuel</p>
        <h1>Hellbound</h1>
        <p class="lede">Sprint, slide, dash and slam through the arenas. Swap weapons to keep your style rank climbing, and tear down the warden at the bottom of every circle.</p>
        <div class="levels" id="levels" role="group" aria-label="Choose a circle"></div>
        <label class="chk"><input type="checkbox" id="unlock"> Unlock every weapon and circle</label>
        <label class="chk">Look sensitivity <input type="range" id="sens" min="2" max="14" value="5"></label>
        <p class="note" style="color:var(--dim)">Click the game to capture your mouse. If the browser blocks that, look with the arrow keys.</p>
        <div class="btns"><button class="btn primary" id="btn-start" type="button">Descend</button></div>
      </div>
    </div>

    <div class="ov" id="ov-pause" hidden>
      <div class="ov-in">
        <h2>Paused</h2>
        <p class="lede">Resume to capture the mouse again.</p>
        <div class="btns">
          <button class="btn primary" id="btn-resume" type="button">Resume</button>
          <button class="btn" id="btn-quit" type="button">Quit to title</button>
        </div>
      </div>
    </div>

    <div class="ov" id="ov-clear" hidden>
      <div class="ov-in">
        <p class="eyebrow" id="clr-eyebrow">Circle cleared</p>
        <h2 id="clr-title">Gate of Ash</h2>
        <div class="grade" id="clr-grade">S</div>
        <dl class="stats">
          <div><dt>Time</dt><dd id="clr-time">0:00</dd></div>
          <div><dt>Hits taken</dt><dd id="clr-hits">0</dd></div>
          <div><dt>Best style</dt><dd id="clr-style">D</dd></div>
          <div><dt>Score</dt><dd id="clr-score">0</dd></div>
        </dl>
        <p class="note" id="clr-note"></p>
        <div class="btns">
          <button class="btn primary" id="btn-next" type="button">Next circle</button>
          <button class="btn" id="btn-replay" type="button">Replay</button>
        </div>
      </div>
    </div>

    <div class="ov" id="ov-dead" hidden>
      <div class="ov-in">
        <p class="eyebrow">Style rank lost</p>
        <h2>You fell</h2>
        <div class="btns">
          <button class="btn primary" id="btn-retry" type="button">Retry circle</button>
          <button class="btn" id="btn-title" type="button">Title</button>
        </div>
      </div>
    </div>
  </div>

  <ul class="keys" aria-label="Controls">
    <li><kbd>WASD</kbd>Move</li>
    <li><kbd>Mouse</kbd>Look</li>
    <li><kbd>LMB</kbd>Fire</li>
    <li><kbd>RMB</kbd>Alt-fire</li>
    <li><kbd>Space</kbd>Jump</li>
    <li><kbd>Shift</kbd>Dash</li>
    <li><kbd>Ctrl</kbd>Slide / air slam</li>
    <li><kbd>1-6</kbd>/<kbd>Q E</kbd>/<kbd>Wheel</kbd>Weapons</li>
    <li><kbd>Esc</kbd>Pause</li>
    <li><kbd>M</kbd>Mute</li>
  </ul>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(()=>{
'use strict';
/* ---------- core ---------- */
const W=1280,H=720,TAU=Math.PI*2;
const A={x0:30,y0:76,x1:1250,y1:646};
const EYE=28,PH=34,CEIL=250,GRAV=560,JUMPV=250;
const cv=document.getElementById('c'),cx=cv.getContext('2d');
const $=id=>document.getElementById(id);
const rnd=(a,b)=>a+Math.random()*(b-a);
const rint=(a,b)=>Math.floor(rnd(a,b+1));
const pick=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const lerp=(a,b,t)=>a+(b-a)*t;
const angDiff=(a,b)=>{let d=a-b;while(d>Math.PI)d-=TAU;while(d<-Math.PI)d+=TAU;return d;};
const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const fmtTime=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');

/* ---------- audio ---------- */
let ac=null,muted=false,noiseBuf=null,lastHitSnd=0;
function initAudio(){if(ac)return;try{ac=new(window.AudioContext||window.webkitAudioContext)();}catch(e){ac=null;}}
function tone(f,d,type,vol,slide){
  if(!ac||muted)return;const t=ac.currentTime,o=ac.createOscillator(),g=ac.createGain();
  o.type=type||'square';o.frequency.setValueAtTime(f,t);
  if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(20,f+slide),t+d);
  g.gain.setValueAtTime(vol||.05,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);
  o.connect(g);g.connect(ac.destination);o.start(t);o.stop(t+d+.02);
}
function noise(d,vol,hp){
  if(!ac||muted)return;
  if(!noiseBuf){noiseBuf=ac.createBuffer(1,ac.sampleRate>>1,ac.sampleRate);const ch=noiseBuf.getChannelData(0);for(let i=0;i<ch.length;i++)ch[i]=Math.random()*2-1;}
  const s=ac.createBufferSource(),f=ac.createBiquadFilter(),g=ac.createGain(),t=ac.currentTime;
  s.buffer=noiseBuf;f.type='highpass';f.frequency.value=hp||800;
  g.gain.setValueAtTime(vol||.08,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);
  s.connect(f);f.connect(g);g.connect(ac.destination);s.start(t);s.stop(t+d);
}
const sfx={
  slash(){noise(.1,.06,1800);tone(220,.09,'sawtooth',.03,-120);},
  shot(){noise(.05,.04,2500);tone(520,.05,'square',.02,-300);},
  shotgun(){noise(.22,.14,300);tone(110,.18,'sawtooth',.07,-70);},
  punch(){noise(.06,.08,500);tone(150,.08,'square',.05,-80);},
  boom(){noise(.45,.15,120);tone(70,.4,'sawtooth',.09,-40);},
  hit(){const n=performance.now();if(n-lastHitSnd<45)return;lastHitSnd=n;tone(180,.05,'square',.03,-90);},
  hurt(){noise(.25,.14,200);tone(90,.25,'sawtooth',.08,-50);},
  dash(){noise(.12,.05,1200);},
  surge(){tone(200,.5,'sawtooth',.06,500);},
  kill(){tone(300,.12,'square',.04,-200);},
  roar(){noise(.9,.15,80);tone(60,.9,'sawtooth',.1,-20);},
  pick(){tone(900,.05,'sine',.02,300);},
  rev(){noise(.07,.1,600);tone(520,.1,'square',.05,-380);tone(90,.1,'sawtooth',.06,-40);},
  rail(){noise(.4,.12,200);tone(90,.4,'sawtooth',.09,-60);tone(1400,.3,'sine',.05,-1100);},
  coin(){tone(1900,.14,'sine',.04,200);tone(2400,.1,'sine',.03);},
  parry(){tone(700,.25,'square',.06,600);noise(.15,.08,2000);},
  jump(){tone(190,.09,'sine',.03,160);},
  land(){noise(.08,.05,250);tone(70,.1,'sine',.05,-30);}
};

/* ---------- data ---------- */
const WEAPONS=[
  {name:'Marksman',col:'#ffd27a',tag:'Revolver',alt:'Coin'},
  {name:'Gatecrasher',col:'#ff9a3a',tag:'Shotgun',alt:'Slug'},
  {name:'Hailstorm',col:'#9fe3ff',tag:'Nailgun',alt:'Saw'},
  {name:'Pale Rail',col:'#c58cff',tag:'Railcannon',alt:'Overcharge'},
  {name:'Wyrm Launcher',col:'#7dff9a',tag:'Rockets',alt:'Seekers'},
  {name:'Saint Knuckles',col:'#ff6a48',tag:'Fists',alt:'Quake'}
];
const RANKS=[
  {l:'D',n:'Dull',t:0,c:'#9a868d'},{l:'C',n:'Cruel',t:14,c:'#d6dae4'},{l:'B',n:'Brutal',t:30,c:'#6fb8ff'},
  {l:'A',n:'Ablaze',t:48,c:'#ffb02e'},{l:'S',n:'Sinful',t:66,c:'#ff6a2e'},{l:'SS',n:'Savage',t:82,c:'#ff3052'},{l:'SSS',n:'Sovereign',t:94,c:'#ffd84a'}
];
const EDEF={
  imp:{r:13,zb:0,h:42,hp:40,sp:150,col:'#d3402a',val:10,orbs:2},
  shade:{r:12,zb:6,h:54,hp:36,sp:110,col:'#9b7bff',val:12,orbs:2},
  brute:{r:23,zb:0,h:68,hp:230,sp:78,col:'#b8581f',val:40,orbs:6},
  wraith:{r:11,zb:10,h:54,hp:30,sp:95,col:'#7be0d0',val:15,orbs:3},
  mite:{r:10,zb:16,h:24,hp:18,sp:205,col:'#ffb02e',val:8,orbs:1}
};
const LEVELS=[
  {name:'Gate of Ash',num:'I',col:'#e0102b',glow:'#ff5a3c',bg:'#12080b',line:'#2b1218',boss:'warden',par:170,
    obst:[{x:400,y:300,r:32},{x:880,y:420,r:32}],
    waves:[{imp:4},{imp:5,shade:2},{imp:4,shade:2,mite:3}]},
  {name:'Choir of Rust',num:'II',col:'#b48cff',glow:'#d6bcff',bg:'#0e0a15',line:'#261b3a',boss:'choir',par:200,
    obst:[{x:360,y:250,r:26},{x:920,y:250,r:26},{x:360,y:470,r:26},{x:920,y:470,r:26}],
    waves:[{imp:5,shade:3},{shade:4,wraith:2},{imp:4,brute:1,shade:3}]},
  {name:'Furnace of Sins',num:'III',col:'#ff8a1f',glow:'#ffc36b',bg:'#150905',line:'#38190b',boss:'furnace',par:230,
    obst:[{x:640,y:361,r:44},{x:300,y:361,r:24},{x:980,y:361,r:24}],
    waves:[{imp:6,mite:4},{brute:2,shade:3},{wraith:4,mite:4,imp:4},{brute:2,imp:4,shade:3}]},
  {name:'Veil of Glass',num:'IV',col:'#3fd9c4',glow:'#9ffff0',bg:'#06121a',line:'#12303d',boss:'widow',par:260,
    obst:[{x:440,y:230,r:22},{x:840,y:230,r:22},{x:440,y:490,r:22},{x:840,y:490,r:22},{x:640,y:361,r:30}],
    waves:[{wraith:4,shade:3},{brute:2,wraith:3,mite:4},{imp:6,wraith:4,shade:4},{brute:3,wraith:4,mite:5}]},
  {name:'Hollow Throne',num:'V',col:'#e8c15a',glow:'#fff0b0',bg:'#0b0a0a',line:'#2d2618',boss:'sovereign',par:340,
    obst:Array.from({length:8},(_,i)=>({x:640+Math.cos(i*TAU/8+.39)*250,y:361+Math.sin(i*TAU/8+.39)*210,r:20})),
    waves:[{imp:6,shade:4,wraith:3},{brute:3,mite:6,shade:3},{wraith:5,brute:2,imp:6},{brute:4,wraith:5,shade:5,mite:6}]}
];

/* ---------- state ---------- */
let mode='title',lvlIdx=0,unlockAll=false,maxLvl=0,selLvl=0;
let P=null,LV=null,boss=null,obst=[];
let enemies=[],ebullets=[],pbullets=[],hazards=[],orbs=[],parts=[],gibs=[],decals=[],slashes=[],tracers=[],coins=[],feed=[];
let WS=[];
let shake=0,hitstop=0,tscale=1,time=0,DT=.016,banners=null,deadShown=false;
let flashT=0,flashX=0,flashY=0,flashZ=20,sens=.00225,hitMark=0;
const keys={},press={},mouse={l:false,r:false,sx:W/2,sy:H/2};
const S={m:0,recent:{},score:0,peak:0};
try{maxLvl=parseInt(localStorage.getItem('hb_max')||'0',10)||0;}catch(e){maxLvl=0;}

/* ---------- style ---------- */
function rankIdx(){let r=0;for(let i=0;i<RANKS.length;i++)if(S.m>=RANKS[i].t)r=i;return r;}
function variety(){let n=0;for(const k in S.recent)if(time-S.recent[k]<6)n++;return [.6,.75,1,1.3,1.6,1.9,2.2][Math.min(n,6)];}
function addStyle(v){S.m=clamp(S.m+v*variety(),0,100);const r=rankIdx();if(r>S.peak)S.peak=r;if(LV&&r>LV.peak)LV.peak=r;}
function addFeed(s,col){feed.unshift({s,col:col||'#efe6d8',t:0});if(feed.length>5)feed.pop();}
function addText(x,y,s,col){if(/^[+\d]/.test(s))return;addFeed(s,col);}
function banner(title,sub,dur,col){banners={title,sub,dur:dur||2,t:0,col:col||'#efe6d8'};}

/* ---------- fx ---------- */
function burst(x,y,n,col,spd,life,size,add,z){
  z=z===undefined?22:z;
  for(let i=0;i<n;i++){
    if(parts.length>700)parts.shift();
    const a=rnd(0,TAU),s=rnd(.25,1)*spd;
    parts.push({x,y,z,vx:Math.cos(a)*s,vy:Math.sin(a)*s,vz:rnd(-.3,1)*s*.8,life:rnd(.5,1)*life,max:life,size:rnd(.6,1)*size,col,drag:2.2,grav:300});
  }
}
function bleed(x,y,z,n,spd,ang){
  for(let i=0;i<n;i++){
    if(gibs.length>520)gibs.shift();
    const a=ang===undefined?rnd(0,TAU):ang+rnd(-.8,.8),s=rnd(.3,1)*spd;
    gibs.push({x,y,z,vx:Math.cos(a)*s,vy:Math.sin(a)*s,vz:rnd(.1,1)*spd*.55,rx:rnd(0,TAU),ry:rnd(0,TAU),sx:rnd(-8,8),sy:rnd(-8,8),size:rnd(1.4,3.2),col:Math.random()<.5?'#a50d1d':'#6e0912',life:rnd(2.5,5),blood:true,rest:false});
  }
}
function gib(x,y,z,n,col,spd){
  for(let i=0;i<n;i++){
    if(gibs.length>520)gibs.shift();
    const a=rnd(0,TAU),s=rnd(.3,1)*spd;
    gibs.push({x,y,z,vx:Math.cos(a)*s,vy:Math.sin(a)*s,vz:rnd(.2,1)*spd*.9,rx:rnd(0,TAU),ry:rnd(0,TAU),sx:rnd(-9,9),sy:rnd(-9,9),size:rnd(3,7),col:pick([col,'#7a0a14','#3a0610','#a50d1d']),life:rnd(4,8),blood:false,rest:false});
  }
}
function addDecal(x,y,r){
  if(decals.length>=260)decals.shift();
  decals.push({x,y,r,rot:rnd(0,TAU),sx:rnd(.7,1.4),sy:rnd(.7,1.4),col:Math.random()<.5?'#5e0710':'#8a0f1b'});
}
function dropOrbs(x,y,n,z){for(let i=0;i<n;i++){const a=rnd(0,TAU),s=rnd(60,200);orbs.push({x,y,z:z===undefined?20:z,vx:Math.cos(a)*s,vy:Math.sin(a)*s,vz:rnd(160,340),t:0});}}

/* ---------- player damage ---------- */
function hurtPlayer(d,ang){
  if(!P||P.inv>0||P.dead||(LV&&LV.phase==='won'))return;
  P.hp-=d;P.inv=.55;P.hurt=.35;LV.hits++;S.m=Math.max(0,S.m-30);
  shake+=10;hitstop=Math.max(hitstop,.06);
  P.hurtAng=ang===undefined?null:ang;
  bleed(P.x,P.y,P.z+20,6,200,undefined);sfx.hurt();
  if(ang!==undefined){P.kx+=Math.cos(ang)*220;P.ky+=Math.sin(ang)*220;}
  if(P.hp<=0){P.hp=0;die();}
}
function die(){
  P.dead=true;mode='dead';tscale=.3;deadShown=false;LV.deadT=0;
  bleed(P.x,P.y,P.z+20,40,360,undefined);shake+=20;
}

/* ---------- enemies: damage + death ---------- */
function mkEnemy(type,x,y){
