function update(realDt){
  const dt=realDt*tscale;DT=dt;time+=dt;
  if(hitstop>0){hitstop-=realDt;updateFx(realDt*.2);return;}
  shake*=Math.pow(.001,realDt);if(shake<.1)shake=0;
  updatePlayer(dt);
  updateWeapon(dt);
  updateWave(dt);
  for(const e of enemies)if(!e.dead)updateEnemy(e,dt);
  separate();
