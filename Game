function separate(){
  for(let i=0;i<enemies.length;i++){
    const a=enemies[i];if(a.dead||a.spawn>0)continue;
    for(let j=i+1;j<enemies.length;j++){
      const b=enemies[j];if(b.dead||b.spawn>0)continue;
      const dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy),mn=a.r+b.r;
      if(d<mn&&d>0){
        const k=(mn-d)/2,nx=dx/d,ny=dy/d;
        if(!a.isBoss){a.x-=nx*k;a.y-=ny*k;}
        if(!b.isBoss){b.x+=nx*k;b.y+=ny*k;}
      }
    }
  }
}

/* ---------- boss framework ---------- */
function* wait(t){for(let a=0;a<t;a+=DT)yield 0;}
function aimAng(o){return Math.atan2(P.y-o.y,P.x-o.x);}
function bossMove(b,dx,dy){
  b.x+=dx;b.y+=dy;
  let hit=clampArena(b,b.r);
  if(pushOut(b,b.r))hit=true;
  return hit;
}
function bshot(b,ang,sp,o){o=o||{};o.dmg=(o.dmg||10)*b.ds;ebullet(b.x,b.y,ang,sp*b.bs,o);}
const BEH={
  chase(b){const a=aimAng(b),d=dist(b,P);if(d>b.r+60){bossMove(b,Math.cos(a)*b.sp*DT,Math.sin(a)*b.sp*DT);}},
  hover(b){
    const tx=W/2+Math.cos(time*.5)*300,ty=(A.y0+A.y1)/2-40+Math.sin(time*.7)*110,a=Math.atan2(ty-b.y,tx-b.x);
    bossMove(b,Math.cos(a)*b.sp*DT,Math.sin(a)*b.sp*DT);
  },
  strafe(b){
    const a=aimAng(b),d=dist(b,P),want=d>330?1:d<250?-1:0,dir=b.dir||1;
    bossMove(b,(Math.cos(a)*want-Math.sin(a)*.8*dir)*b.sp*DT,(Math.sin(a)*want+Math.cos(a)*.8*dir)*b.sp*DT);
  }
};
function* restMove(b,t){for(let a=0;a<t;a+=DT){BEH[b.beh](b);yield 0;}}

function* chargeAtk(b,n){
  n=n||1;
  for(let i=0;i<n;i++){
    const a=aimAng(b),tel=.75*(1-.14*b.phase);
    b.face=a;b.lock=true;
    addLine({x:b.x,y:b.y,ang:a,len:1100,w:b.r*1.6,dur:tel,dmg:0,col:b.col});
    yield* wait(tel);
    b.contact=true;b.cdmg=20*b.ds;
    let t=0,hit=false;
    while(t<.6){
      hit=bossMove(b,Math.cos(a)*820*DT,Math.sin(a)*820*DT);
      if(Math.random()<.7)burst(b.x,b.y,1,b.col,80,.4,5,true);
      if(hit)break;t+=DT;yield 0;
    }
    b.contact=false;b.lock=false;
    if(hit){
      b.vuln=2;shake+=14;burst(b.x,b.y,24,b.col,360,.6,4,true);
      addText(b.x,b.y-b.r-14,'STAGGERED','#ffd84a',22);
      addWave({x:b.x,y:b.y,sp:300,dmg:12*b.ds,col:b.col});
