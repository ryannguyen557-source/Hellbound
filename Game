  cx.textAlign=align||'left';cx.fillStyle=col;cx.fillText(s,x,y);
}
function slantBar(x,y,w,h,f,col,back){
  const sk=h*.6;
  cx.fillStyle=back;cx.beginPath();cx.moveTo(x+sk,y);cx.lineTo(x+w+sk,y);cx.lineTo(x+w,y+h);cx.lineTo(x,y+h);cx.closePath();cx.fill();
  const fw=w*clamp(f,0,1);if(fw<=0)return;
  cx.fillStyle=col;cx.beginPath();cx.moveTo(x+sk,y);cx.lineTo(x+fw+sk,y);cx.lineTo(x+fw,y+h);cx.lineTo(x,y+h);cx.closePath();cx.fill();
}
function drawCrosshair(){
  const x=W/2,y=H/2,c=WEAPONS[P.wep].col;
  cx.strokeStyle=c;cx.fillStyle='#fff';cx.lineWidth=2;cx.globalAlpha=.95;
  cx.fillRect(x-1.5,y-1.5,3,3);
  cx.beginPath();
  for(const a of [0,1,2,3]){const dx=[1,0,-1,0][a],dy=[0,1,0,-1][a];cx.moveTo(x+dx*10,y+dy*10);cx.lineTo(x+dx*19,y+dy*19);}
  cx.stroke();
  if(hitMark>0){
    const k=hitMark>.2?'#ff3a3a':'#ffffff',s=hitMark*60;cx.strokeStyle=k;cx.lineWidth=3;cx.beginPath();
    for(const [dx,dy] of [[1,1],[-1,1],[1,-1],[-1,-1]]){cx.moveTo(x+dx*8,y+dy*8);cx.lineTo(x+dx*(14+s*.2),y+dy*(14+s*.2));}
    cx.stroke();
  }
  cx.globalAlpha=1;
  if(P.charge>0){
    cx.fillStyle='rgba(0,0,0,.5)';cx.fillRect(x-40,y+34,80,6);cx.fillStyle=c;cx.fillRect(x-40,y+34,80*P.charge,6);
  }
}
function drawHUD(){
  const lv=LEVELS[lvlIdx];
  // health
  const hpF=P.hp/P.max,low=hpF<.3;
  txt(String(Math.ceil(P.hp)),34,H-58,70,low?'#ff4a4a':'#efe6d8','left','d');
  slantBar(34,H-44,260,16,hpF,low?'#ff3a3a':'#e0102b','#2a0b13');
  for(let i=0;i<3;i++){
    const f=clamp(P.dash-i,0,1);
    cx.fillStyle='rgba(40,26,30,.85)';cx.fillRect(34+i*58,H-20,50,7);
    cx.fillStyle=f>=1?'#9fe3ff':'#4a7a8a';cx.fillRect(34+i*58,H-20,50*f,7);
  }
  // rank
  const ri=rankIdx(),R=RANKS[ri];
  txt(R.l,W-34,70,66,R.c,'right','d');
  txt(R.n.toUpperCase(),W-34,24,18,R.c,'right');
  const nx=RANKS[ri+1]?RANKS[ri+1].t:100,fr=(S.m-R.t)/Math.max(1,nx-R.t);
  slantBar(W-250,76,200,6,fr,R.c,'rgba(40,26,30,.85)');
  txt('x'+variety().toFixed(2)+' VARIETY',W-250,66,13,'#9a868d','left');
  let fy=108;
  for(const f of feed){cx.globalAlpha=clamp(1.6-f.t*.7,0,1);txt(f.s,W-34,fy,20,f.col,'right');fy+=22;}
  cx.globalAlpha=1;
  // centre top
  if(boss&&!boss.dead&&LV.phase==='boss'){
    txt(boss.name.toUpperCase(),W/2,26,20,boss.col,'center');
    const bw=620;cx.fillStyle='rgba(26,11,16,.9)';cx.fillRect(W/2-bw/2,34,bw,12);
    cx.fillStyle=boss.col;cx.fillRect(W/2-bw/2,34,bw*clamp(boss.hp/boss.max,0,1),12);
    cx.fillStyle='#0b0609';for(const t of boss.thr)if(t>0)cx.fillRect(W/2-bw/2+bw*t-1,34,2,12);
    cx.strokeStyle='rgba(239,230,216,.45)';cx.strokeRect(W/2-bw/2,34,bw,12);
  }else{
    txt(lv.num+'  ·  '+lv.name.toUpperCase(),W/2,26,19,lv.glow,'center');
    const wv=LV.phase==='wave'||LV.phase==='gap'?'WAVE '+(LV.wave+1)+' / '+lv.waves.length+'  ·  '+(enemies.length+LV.queue.length)+' LEFT':LV.phase==='boss'||LV.phase==='bossIntro'?'BOSS':'';
    txt(wv,W/2,47,15,'#cdbfc3','center');
  }
  txt('SCORE '+S.score.toLocaleString()+'   ·   '+fmtTime(LV.time),W/2,H-20,15,'rgba(239,230,216,.8)','center');
  // weapons (bottom right)
  const n=unlockedCount();
  for(let i=0;i<6;i++){
    const wp=WEAPONS[i],sel=i===P.wep,has=i<n,y=H-30-(5-i)*30,x=W-250;
    cx.globalAlpha=has?(sel?1:.62):.3;
    cx.fillStyle=sel?'rgba(42,11,19,.88)':'rgba(10,4,6,.6)';cx.fillRect(x,y-20,216,26);
    if(sel){cx.fillStyle=wp.col;cx.fillRect(x,y-20,3,26);}
    txt(String(i+1),x+14,y,18,has?wp.col:'#4a3a40','left');
    txt(has?wp.name.toUpperCase():'LOCKED',x+34,y-1,16,'#efe6d8','left');
    if(has)txt(wp.alt.toUpperCase(),x+208,y-1,13,'#9a868d','right');
    cx.globalAlpha=1;
  }
  // slide / slam hints for first level
  if(lvlIdx===0&&LV.phase==='intro'||(lvlIdx===0&&LV.phase==='wave'&&LV.wave===0&&LV.time<14)){
    txt('SPACE JUMP   ·   SHIFT DASH   ·   CTRL SLIDE / AIR SLAM   ·   LMB / RMB FIRE',W/2,H-60,16,'rgba(239,230,216,.75)','center');
  }
}
function drawBanner(){
  if(!banners)return;
  const b=banners,p=b.t/b.dur,a=p<.12?p/.12:p>.8?(1-p)/.2:1;
  cx.globalAlpha=clamp(a,0,1);
  const big=b.dur>=2.4;
  if(big){cx.fillStyle='rgba(0,0,0,.55)';cx.fillRect(0,H*.28,W,150);}
  txt(b.title,W/2,H*.28+(big?90:60),big?84:60,b.col,'center','d');
  if(b.sub)txt(b.sub.toUpperCase(),W/2,H*.28+(big?128:92),22,'#efe6d8','center');
  cx.globalAlpha=1;
}
function drawScreenFx(){
  if(P.hurt>0){const v=cx.createRadialGradient(W/2,H/2,H*.3,W/2,H/2,H*.9);v.addColorStop(0,'rgba(224,16,43,0)');v.addColorStop(1,'rgba(224,16,43,'+Math.min(.8,P.hurt*2.2)+')');cx.fillStyle=v;cx.fillRect(0,0,W,H);}
  if(P.hp<30&&!P.dead){const a=.18+.12*Math.sin(time*7);const v=cx.createRadialGradient(W/2,H/2,H*.4,W/2,H/2,H*.9);v.addColorStop(0,'rgba(160,0,20,0)');v.addColorStop(1,'rgba(160,0,20,'+a+')');cx.fillStyle=v;cx.fillRect(0,0,W,H);}
  if(P.dashFx>0){
    cx.strokeStyle='rgba(255,255,255,'+(P.dashFx*2.2)+')';cx.lineWidth=2;
    for(let i=0;i<22;i++){const a=i*TAU/22+.1,r0=H*(.32+((i*37)%10)/60),r1=r0+H*.25;cx.beginPath();cx.moveTo(W/2+Math.cos(a)*r0*1.6,H/2+Math.sin(a)*r0);cx.lineTo(W/2+Math.cos(a)*r1*1.6,H/2+Math.sin(a)*r1);cx.stroke();}
  }
  if(P.hurt>0&&P.hurtAng!==null){
    const rel=angDiff(P.hurtAng+Math.PI,P.yaw),ax=W/2+Math.sin(rel)*210,ay=H/2-Math.cos(rel)*150;
    cx.fillStyle='rgba(255,40,60,'+Math.min(1,P.hurt*3)+')';cx.save();cx.translate(ax,ay);cx.rotate(rel);cx.beginPath();cx.moveTo(0,-18);cx.lineTo(16,14);cx.lineTo(-16,14);cx.fill();cx.restore();
  }
  if(P.slam){cx.fillStyle='rgba(255,106,72,.1)';cx.fillRect(0,0,W,H);}
  if(P.dead){cx.fillStyle='rgba(60,0,8,.45)';cx.fillRect(0,0,W,H);}
}
function render(dt){
  renderGL(dt);
  cx.setTransform(viewScale,0,0,viewScale,0,0);cx.clearRect(0,0,W,H);
  if(!P||!LV)return;
  hitMark=Math.max(0,hitMark-(dt||.016));
  drawScreenFx();
  if(LV.phase==='bossIntro'){cx.fillStyle='rgba(0,0,0,.3)';cx.fillRect(0,0,W,H);}
  if(!P.dead){drawHUD();drawCrosshair();}
  drawBanner();
}

/* ================= overlays + input ================= */
function lockMouse(){try{const r=cv.requestPointerLock();if(r&&r.catch)r.catch(()=>{});}catch(e){}}
function hideOverlays(){for(const id of ['ov-title','ov-pause','ov-clear','ov-dead'])$(id).hidden=true;}
function buildChips(){
  const box=$('levels');box.textContent='';
  LEVELS.forEach((lv,i)=>{
    const b=document.createElement('button');b.type='button';b.className='chip';
    b.innerHTML='<b>'+lv.num+'</b>'+lv.name;
    b.disabled=!(unlockAll||i<=maxLvl);b.setAttribute('aria-pressed',String(i===selLvl));
    b.addEventListener('click',()=>{selLvl=i;lvlIdx=i;buildChips();buildLevel();});
    box.appendChild(b);
  });
}
function toTitle(){
  try{document.exitPointerLock();}catch(e){}
  mode='title';hideOverlays();$('ov-title').hidden=false;if(!unlockAll&&selLvl>maxLvl)selLvl=maxLvl;lvlIdx=selLvl;buildChips();buildLevel();P=null;LV=null;enemies=[];banners=null;
  parts=[];gibs=[];decals=[];tracers=[];coins=[];feed=[];ebullets=[];pbullets=[];hazards=[];slashes=[];orbs=[];
  $('btn-start').focus();
}
function pause(){if(mode==='playing'){mode='paused';$('ov-pause').hidden=false;$('btn-resume').focus();for(const k in keys)keys[k]=false;mouse.l=mouse.r=false;}}
function resume(){if(mode==='paused'){mode='playing';$('ov-pause').hidden=true;lockMouse();}}
function startGame(i){initAudio();S.score=0;startLevel(i);lockMouse();}

$('unlock').addEventListener('change',e=>{unlockAll=e.target.checked;buildChips();});
$('sens').addEventListener('input',e=>{sens=parseInt(e.target.value,10)*.00045;});
$('btn-start').addEventListener('click',()=>startGame(selLvl));
$('btn-resume').addEventListener('click',resume);
$('btn-quit').addEventListener('click',toTitle);
$('btn-title').addEventListener('click',toTitle);
$('btn-retry').addEventListener('click',()=>{S.score=LV?LV.scoreStart:0;initAudio();startLevel(lvlIdx);lockMouse();});
$('btn-replay').addEventListener('click',()=>{S.score=LV.scoreStart;initAudio();startLevel(lvlIdx);lockMouse();});
$('btn-next').addEventListener('click',()=>{if(lvlIdx>=LEVELS.length-1)toTitle();else{initAudio();startLevel(lvlIdx+1);lockMouse();}});

const BLOCK=new Set(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','ControlLeft']);
window.addEventListener('keydown',e=>{
  if((mode==='playing'||mode==='paused')&&BLOCK.has(e.code)&&document.activeElement===cv)e.preventDefault();
  if(e.repeat)return;
  keys[e.code]=true;
  if(e.code==='Space'&&mode==='playing')press.Space=true;
  if(e.code==='ShiftLeft'||e.code==='ShiftRight')press.Shift=true;
  if(e.code==='KeyM'){muted=!muted;}
  if(e.code==='KeyP'||e.code==='Escape'){if(mode==='playing')pause();else if(mode==='paused')resume();}
  if(mode==='playing'){
    if(e.code>='Digit1'&&e.code<='Digit6')selectWeapon(parseInt(e.code.slice(5),10)-1);
    if(e.code==='KeyQ')cycleWeapon(-1);
    if(e.code==='KeyE')cycleWeapon(1);
  }
});
window.addEventListener('keyup',e=>{keys[e.code]=false;});
document.addEventListener('mousemove',e=>{
  if(mode!=='playing'||!P||P.dead)return;
  if(document.pointerLockElement===cv){P.yaw+=e.movementX*sens;P.pitch=clamp(P.pitch-e.movementY*sens,-1.5,1.5);}
});
cv.addEventListener('mousedown',e=>{
  initAudio();cv.focus();e.preventDefault();
  if(mode!=='playing')return;
  if(document.pointerLockElement!==cv)lockMouse();
  if(e.button===0)mouse.l=true;if(e.button===2)mouse.r=true;
});
window.addEventListener('mouseup',e=>{if(e.button===0)mouse.l=false;if(e.button===2)mouse.r=false;});
cv.addEventListener('contextmenu',e=>e.preventDefault());
cv.addEventListener('wheel',e=>{if(mode==='playing'){e.preventDefault();cycleWeapon(e.deltaY>0?1:-1);}},{passive:false});
document.addEventListener('pointerlockchange',()=>{if(document.pointerLockElement!==cv&&mode==='playing')pause();});
window.addEventListener('blur',()=>{mouse.l=false;mouse.r=false;for(const k in keys)keys[k]=false;pause();});

function resize(){
  const r=cv.getBoundingClientRect(),dpr=window.devicePixelRatio||1;
  viewScale=clamp((r.width*dpr)/W,.5,2);
  cv.width=Math.round(W*viewScale);cv.height=Math.round(H*viewScale);
}
if(window.ResizeObserver)new ResizeObserver(resize).observe($('stage'));
window.addEventListener('resize',resize);

/* ---------- main loop ---------- */
let last=performance.now(),glOK=true;
function frame(now){
  const dt=Math.min(.033,(now-last)/1000);last=now;
  try{
    if(mode==='playing'||mode==='dead'){update(dt);updateCamera(dt);}
    else{
      if(mode==='title'){
        time+=dt;
        if(Math.random()<dt*10)parts.push({x:rnd(A.x0,A.x1),y:rnd(A.y0,A.y1),z:rnd(0,60),vx:rnd(-10,10),vy:rnd(-10,10),vz:rnd(8,30),life:3,max:3,size:2,col:LEVELS[lvlIdx].col,drag:.1,grav:0});
        for(const p of parts){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.z+=p.vz*dt;}
        parts=parts.filter(p=>p.life>0);
      }
      updateCamera(dt);
    }
    render(dt);
  }catch(err){
    if(glOK){glOK=false;console.error(err);const l=document.querySelector('.lede');if(l)l.textContent='The 3D renderer hit an error: '+err.message;}
  }
  for(const k in press)press[k]=false;
  requestAnimationFrame(frame);
}
lvlIdx=0;initWeapons();
try{initGL();}catch(err){glOK=false;console.error(err);const l=document.querySelector('.lede');if(l)l.textContent='WebGL could not start in this browser, so the 3D view is unavailable.';}
resize();buildChips();buildLevel();
requestAnimationFrame(frame);
})();
</script>

</body></html>
