  }else P.sliding=false;
  if(P.sliding){P.slideV=Math.max(260,P.slideV-420*dt);if(ml>0)P.slideA+=clamp(angDiff(Math.atan2(my,mx),P.slideA),-1.4*dt,1.4*dt);if(Math.random()<.5)burst(P.x,P.y,1,'#c8b8a0',60,.3,2,true,3);}
  // vertical
  P.vz-=GRAV*dt*(P.slam?.4:1);P.z+=P.vz*dt;
  if(P.z<=0){
    const wasAir=!P.ground;P.z=0;
    if(wasAir&&P.vz<-260){sfx.land();P.landT=.2;}
    if(P.slam){P.slam=false;P.vz=0;slamImpact();}else if(P.vz<0)P.vz=0;
    P.ground=true;
  }else P.ground=false;
  if(P.z+PH>CEIL){P.z=CEIL-PH;if(P.vz>0)P.vz=0;}
  // horizontal
  let vx,vy;
  if(P.dashT>0){P.dashT-=dt;vx=Math.cos(P.dashA)*950;vy=Math.sin(P.dashA)*950;P.inv=Math.max(P.inv,.1);P.vx=vx*.4;P.vy=vy*.4;}
  else if(P.sliding){vx=Math.cos(P.slideA)*P.slideV;vy=Math.sin(P.slideA)*P.slideV;P.vx=vx;P.vy=vy;}
  else{
    const sp=275,tx=mx*sp,ty=my*sp,ac=P.ground?(ml>0?3600:3000):1500;
