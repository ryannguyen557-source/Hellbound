      else if(Math.abs(g.vz)>90){g.vz=-g.vz*.38;g.vx*=.6;g.vy*=.6;g.sx*=.5;g.sy*=.5;if(Math.random()<.5)addDecal(g.x,g.y,g.size*1.6);}
      else{g.rest=true;g.vz=0;}
    }
  }
  gibs=gibs.filter(g=>g.life>0);
  for(const s of slashes)s.t+=dt;
  slashes=slashes.filter(s=>s.t<s.dur);
  for(const t of tracers)t.t+=dt;
  tracers=tracers.filter(t=>t.t<t.dur);
