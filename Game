function updateFx(dt){
  for(const p of parts){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.z+=p.vz*dt;p.vz-=p.grav*dt;const k=Math.exp(-p.drag*dt);p.vx*=k;p.vy*=k;if(p.z<1){p.z=1;p.vz=Math.abs(p.vz)*.3;}}
