      const fx=ox-ob.x,fy=oy-ob.y,b=2*(fx*dx+fy*dy),c=fx*fx+fy*fy-ob.r*ob.r,disc=b*b-4*a*c;
      if(disc>0){const t=(-b-Math.sqrt(disc))/(2*a);if(t>0&&t<tw)tw=t;}
    }
