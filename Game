function updViewmodel(dt){
  if(!vm)return;
  const show=P&&LV&&!P.dead&&mode!=='title';
  vm.root.visible=!!show;if(!show){vm.vf.intensity=0;return;}
  vm.groups.forEach((g,i)=>g.visible=i===P.wep);
  const g=vm.groups[P.wep],u=g.userData,w=WS[P.wep];
  const bobx=P.ground&&!P.sliding?Math.sin(P.step*1.1)*.012:0,boby=P.ground&&!P.sliding?Math.abs(Math.cos(P.step*1.1))*.014:0;
  const sw=P.swapT>0?Math.min(1,P.swapT/.28):0;
  let px=.27+bobx-P.strafe*.015,py=-.24+boby-sw*.4-(P.sliding?.05:0),pz=-.62+P.recoil*.09;
  let rx=P.recoil*.11+(P.sliding?.1:0),ry=0,rz=-P.strafe*.04;
  if(P.wep===5){
    const pt=P.punchT>0?Math.sin((1-P.punchT/.24)*Math.PI):0;
    pz-=pt*.45;px-=pt*.12;ry=pt*.4;rx-=pt*.15;
    if(w.holding){const c=P.charge;px+=rnd(-1,1)*.006*c;py+=rnd(-1,1)*.006*c;pz+=.05*c;}
  }
  if(P.wep===3){const c=u.core;if(c)c.material.emissiveIntensity=1.2+P.charge*3;if(w.holding){px+=rnd(-1,1)*.004*P.charge;py+=rnd(-1,1)*.004*P.charge;}}
  g.position.set(px,py,pz);g.rotation.set(rx,ry,rz);
  if(u.spin){if(P.wep===2)u.spin.rotation.z+=(mouse.l?22:2)*dt;else u.spin.rotation.z+=P.recoil*.3;}
  if(u.flash){const on=P.flash>0;u.flash.visible=on;if(on){u.flash.rotation.z=rnd(0,6.28);u.flash.scale.setScalar(.12+P.flash*(P.wep===1?4:2.2));}}
  vm.vf.intensity=P.flash>0?2.4:0;
  vCam.aspect=16/9;
}

/* ---------- camera ---------- */
function updateCamera(dt){
  if(!camera)return;
  if(P&&mode!=='title'){
    const bobY=P.ground&&!P.sliding?Math.sin(P.step*2.2)*.03:0;
    camera.position.set(wx(P.x),wy(P.z+P.eyeh)+bobY,wz(P.y));
    const sh=Math.min(.05,shake*.0035);
    const roll=-P.strafe*.02+(P.sliding?.06:0)+(P.hurt>0?rnd(-.01,.01):0);
    camera.rotation.set(clamp(P.pitch,-1.5,1.5)+rnd(-sh,sh),-P.yaw-Math.PI/2+rnd(-sh,sh),roll);
    const spd=Math.hypot(P.vx,P.vy);
    const fov=100+(P.dashT>0?14:0)+(P.sliding?5:0)+Math.min(6,spd/70)+(P.slam?10:0);
    if(Math.abs(camera.fov-fov)>.05){camera.fov=lerp(camera.fov,fov,Math.min(1,dt*10));camera.updateProjectionMatrix();}
  }else{
    const a=time*.1;camera.position.set(Math.sin(a)*26,9,Math.cos(a)*12);camera.lookAt(0,5,0);
    if(Math.abs(camera.fov-80)>.1){camera.fov=80;camera.updateProjectionMatrix();}
  }
  camera.updateMatrixWorld(true);
}

/* ---------- render ---------- */
function renderGL(dt){
  if(!renderer)return;
  const live=!!(LV&&P);
  syncMap(maps.enemies,live?enemies:[],makeEnemy,updateEnemyMesh);
  syncMap(maps.hazards,live?hazards:[],makeHazard,updHazard);
  syncMap(maps.slashes,live?slashes:[],makeSlash,updSlash);
  syncMap(maps.tracers,live?tracers:[],makeTracer,updTracer);
  updBullets();updGibs();updParts();
  plight.position.copy(camera.position);
  if(live){
    plight.intensity=.85;
    hurtLight.position.copy(camera.position);hurtLight.intensity=P.hurt>0?P.hurt*10:0;
    if(flashT>0){flashT-=dt||.016;flight.position.set(wx(flashX),wy(flashZ),wz(flashY));flight.intensity=Math.max(0,flashT/.18)*7;}else flight.intensity=0;
    if(P.flash>0){plight.intensity=2.2;}
  }else{plight.intensity=.5;hurtLight.intensity=0;flight.intensity=0;}
  renderer.clear();renderer.render(scene,camera);
  updViewmodel(dt||.016);
  if(vm&&vm.root.visible){renderer.clearDepth();renderer.render(vScene,vCam);}
}
