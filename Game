/* ---------- enemy AI ---------- */
function enemyShot(e,ang,sp,dmg){ebullet(e.x+Math.cos(ang)*e.r,e.y+Math.sin(ang)*e.r,ang,sp,{dmg,r:5,col:'#c9a0ff'});}
function moveEnt(e,mx,my,dt){
