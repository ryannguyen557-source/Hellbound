function spawnBoss(id){
  const D=BOSSES[id];
  const b={isBoss:true,type:'boss',id,name:D.name,title:D.title,x:W/2,y:A.y0+150,r:D.r,zb:0,h:D.r*2.8,hp:D.hp,max:D.hp,vx:0,vy:0,kx:0,ky:0,spawn:1.4,st:0,t:0,
    flash:0,stun:0,face:Math.PI/2,dead:false,vuln:0,invuln:0,phase:0,thr:D.thr,col:D.col,ds:D.ds,bs:D.bs,sp:D.sp,beh:D.beh,rest:D.rest,
