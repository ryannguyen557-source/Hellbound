    g.vz-=GRAV*1.1*dt;g.x+=g.vx*dt;g.y+=g.vy*dt;g.z+=g.vz*dt;g.rx+=g.sx*dt;g.ry+=g.sy*dt;
    if(g.x<A.x0||g.x>A.x1){g.vx*=-.4;g.x=clamp(g.x,A.x0,A.x1);}
    if(g.y<A.y0||g.y>A.y1){g.vy*=-.4;g.y=clamp(g.y,A.y0,A.y1);}
    if(g.z<g.size*.5){
